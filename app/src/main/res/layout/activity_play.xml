<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PlayActivity">

    <TextView
        android:id="@+id/equation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:textAlignment="center"
        android:textColor="@android:color/black"
        android:textSize="50sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1+1=?" />

    <Button
        android:id="@+id/option1"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="140dp"
        android:paddingHorizontal="50dp"
        android:paddingVertical="25dp"
        android:text="Button"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/equation"
        tools:text="1" />

    <Button
        android:id="@+id/option2"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="44dp"
        android:paddingHorizontal="50dp"
        android:paddingVertical="25dp"
        android:text="Button"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/option1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/option1"
        app:layout_constraintVertical_bias="0.0"
        tools:text="2" />

    <Button
        android:id="@+id/option3"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="100dp"
        android:paddingHorizontal="50dp"
        android:paddingVertical="25dp"
        android:text="Button"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/option1"
        tools:text="3" />

    <Button
        android:id="@+id/option4"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="44dp"
        android:paddingHorizontal="50dp"
        android:paddingVertical="25dp"
        android:text="Button"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/option3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/option3"
        app:layout_constraintVertical_bias="0.0"
        tools:text="10" />
</androidx.constraintlayout.widget.ConstraintLayout>